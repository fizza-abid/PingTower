{
  "name": "pingtower",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP uptime and latency monitoring dashboard",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "npm test --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "lint": "npm run lint --workspace client",
    "build": "npm run build --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client"
  }
}
