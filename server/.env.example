# --- Required ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/pingtower

# Secret for POST /api/internal/run-checks. Generate with: openssl rand -hex 32
# In production this must be set and at least 32 characters (the server refuses
# to boot otherwise). In development a random ephemeral value is generated.
CRON_SECRET=

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated origin allowlist, or * for any origin (development only).
CORS_ORIGIN=*
# Enable only when behind a trusted reverse proxy.
TRUST_PROXY=false

# --- Monitoring -------------------------------------------------------------
# Run the scheduler inside this process. Leave false when an external scheduler
# (cron job, CI schedule) POSTs to /api/internal/run-checks instead, and never
# enable it on more than one replica or every check runs twice.
ENABLE_LOCAL_CRON=true
CHECK_CRON=*/5 * * * *
CHECK_TIMEOUT_MS=10000
CHECK_CONCURRENCY=5
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=2097152
# Consecutive failures before a monitor is marked down and an alert is sent.
FAIL_THRESHOLD=3
# Checks older than this are deleted by a TTL index. If you change it, drop the
# existing index first: db.checks.dropIndex("checkedAt_1")
CHECK_RETENTION_DAYS=30
CHECK_USER_AGENT=PingTower/1.0 (+https://github.com/fizza-abid/PingTower)

# --- Email alerts -----------------------------------------------------------
# Email is disabled until explicitly enabled. Credentials are never committed.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when omitted.
MAIL_FROM="PingTower <alerts@example.com>"
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=20000

# --- Rate limiting (POST /api/projects/:id/check) ---------------------------
CHECK_RATE_LIMIT_WINDOW_MS=60000
CHECK_RATE_LIMIT_MAX=20

# --- Development only -------------------------------------------------------
# Permits loopback/private targets, bypassing the SSRF guard. NEVER enable this
# on a publicly reachable server.
ALLOW_PRIVATE_TARGETS=false
